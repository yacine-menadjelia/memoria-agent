<?xml version="1.0" encoding="utf-8"?>
<!--
  Le backend local tourne en HTTP (pas HTTPS) — Android 9+ bloque le
  trafic non chiffré par défaut. Scopé au build debug uniquement (via
  src/debug/, jamais fusionné dans le manifest release) : on n'autorise
  le cleartext que vers localhost, jamais de façon globale. L'app
  cible toujours localhost:8000 (voir ApiClient) ; sur Android
  (émulateur ou appareil physique), `adb reverse tcp:8000 tcp:8000`
  redirige ce port vers le backend de l'hôte.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
